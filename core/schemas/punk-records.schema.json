{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ckomiya/vegapunk-agents/blob/main/core/schemas/punk-records.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Copyright 2026 Christian Gonzales Komiya",
  "title": "Punk Records",
  "description": "Shared, append-only memory of one vegapunk-agents mission.",
  "type": "object",
  "required": ["schema_version", "mission", "state", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.3.0" },
    "mission": {
      "type": "object",
      "required": ["id", "goal", "mode", "roster", "constraints", "max_iterations", "research_rounds", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "goal": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["light", "standard", "full"] },
        "roster": {
          "type": "array",
          "items": { "$ref": "#/$defs/satelliteId" },
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "punk-01-shaka" }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "max_iterations": { "type": "integer", "minimum": 0, "default": 2 },
        "research_rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Maximum number of times the mission may enter RESEARCH."
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "state": {
      "type": "object",
      "required": ["phase", "iteration", "research_round", "status", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "phase": { "$ref": "#/$defs/phase" },
        "iteration": { "type": "integer", "minimum": 0 },
        "research_round": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of times the mission has entered RESEARCH."
        },
        "status": { "enum": ["active", "completed", "incomplete", "failed", "aborted"] },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "satelliteId": {
      "enum": [
        "punk-01-shaka",
        "punk-02-lilith",
        "punk-03-edison",
        "punk-04-pythagoras",
        "punk-05-atlas",
        "punk-06-york"
      ]
    },
    "authorId": {
      "enum": [
        "stella",
        "punk-01-shaka",
        "punk-02-lilith",
        "punk-03-edison",
        "punk-04-pythagoras",
        "punk-05-atlas",
        "punk-06-york"
      ]
    },
    "phase": {
      "enum": [
        "DEFINED",
        "RESEARCH",
        "IDEATION",
        "CRITIQUE",
        "REVISION",
        "VERDICT",
        "HITL_APPROVAL",
        "EXECUTION",
        "OPERATIONS",
        "COMPLETED",
        "INCOMPLETE",
        "FAILED",
        "ABORTED"
      ]
    },
    "recordType": {
      "enum": [
        "goal",
        "finding",
        "proposal",
        "critique",
        "revision",
        "verdict",
        "approval",
        "artifact",
        "ops_log",
        "flag",
        "refusal",
        "note"
      ]
    },
    "verdictValue": {
      "enum": ["APPROVED", "NEEDS_REVISION", "REJECTED"]
    },
    "record": {
      "type": "object",
      "required": ["id", "author", "type", "phase", "iteration", "content", "refs", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "author": { "$ref": "#/$defs/authorId" },
        "type": { "$ref": "#/$defs/recordType" },
        "phase": { "$ref": "#/$defs/phase" },
        "iteration": { "type": "integer", "minimum": 0 },
        "content": { "type": "string", "description": "Markdown allowed." },
        "refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Ids of earlier records this record builds on or corrects."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verdict": { "$ref": "#/$defs/verdictValue" },
        "blocking": {
          "type": "boolean",
          "description": "Critiques only. true if the critique raises issues that must be addressed before a verdict."
        },
        "provenance": {
          "enum": ["external", "internal", "unsourced"],
          "description": "Findings only. external: backed by sources outside the mission; internal: derived from mission records (refs); unsourced: the satellite's own knowledge, with no citable source."
        },
        "sources": {
          "type": "array",
          "description": "Findings only. Sources behind the finding; at least one if provenance is external, none if provenance is unsourced.",
          "items": {
            "type": "object",
            "required": ["locator", "access"],
            "additionalProperties": false,
            "properties": {
              "locator": { "type": "string", "minLength": 1, "description": "URL or other locator of the source." },
              "access": {
                "enum": ["opened", "snippet"],
                "description": "opened: the source itself was read; snippet: only an excerpt was seen."
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "description": "Findings only. Open questions that further research should answer.",
          "items": {
            "type": "object",
            "required": ["question", "why_needed"],
            "additionalProperties": false,
            "properties": {
              "question": { "type": "string", "minLength": 1, "description": "What is still unknown." },
              "why_needed": { "type": "string", "minLength": 1, "description": "Why the mission needs the answer." }
            }
          }
        },
        "reason": {
          "enum": ["capability_mismatch", "missing_input", "constraint_conflict"],
          "description": "Refusals only. Why the satellite declines the task."
        },
        "flag_resolutions": {
          "type": "array",
          "minItems": 1,
          "description": "Verdicts only. Decision on each flag the verdict resolves.",
          "items": {
            "type": "object",
            "required": ["flag", "decision"],
            "additionalProperties": false,
            "properties": {
              "flag": { "$ref": "#/$defs/id", "description": "Id of the flag record." },
              "decision": {
                "enum": ["upheld", "dismissed"],
                "description": "upheld: the flag stands; dismissed: it does not."
              }
            }
          }
        },
        "ready_to_close": {
          "type": "boolean",
          "description": "Ops logs only. true if the mission can be closed."
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "critique" } }, "required": ["type"] },
          "then": { "required": ["blocking"] },
          "else": { "not": { "required": ["blocking"] } }
        },
        {
          "if": { "properties": { "type": { "const": "verdict" } }, "required": ["type"] },
          "then": { "required": ["verdict"] },
          "else": {
            "not": { "anyOf": [{ "required": ["verdict"] }, { "required": ["flag_resolutions"] }] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "finding" } }, "required": ["type"] },
          "then": { "required": ["provenance", "sources"] },
          "else": {
            "not": {
              "anyOf": [{ "required": ["provenance"] }, { "required": ["sources"] }, { "required": ["gaps"] }]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "finding" }, "provenance": { "const": "external" } },
            "required": ["type", "provenance"]
          },
          "then": { "properties": { "sources": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "type": { "const": "finding" }, "provenance": { "const": "internal" } },
            "required": ["type", "provenance"]
          },
          "then": { "properties": { "refs": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "type": { "const": "finding" }, "provenance": { "const": "unsourced" } },
            "required": ["type", "provenance"]
          },
          "then": { "properties": { "sources": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "type": { "const": "refusal" } }, "required": ["type"] },
          "then": { "required": ["reason"] },
          "else": { "not": { "required": ["reason"] } }
        },
        {
          "if": { "properties": { "type": { "const": "flag" } }, "required": ["type"] },
          "then": { "properties": { "refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "type": { "const": "ops_log" } }, "required": ["type"] },
          "then": { "required": ["ready_to_close"] },
          "else": { "not": { "required": ["ready_to_close"] } }
        },
        {
          "if": { "properties": { "author": { "const": "stella" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["goal", "approval", "flag", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-01-shaka" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["verdict", "flag", "refusal", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-02-lilith" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["critique", "flag", "refusal", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-03-edison" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["proposal", "revision", "flag", "refusal", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-04-pythagoras" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["finding", "flag", "refusal", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-05-atlas" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["artifact", "flag", "refusal", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-06-york" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["ops_log", "flag", "refusal", "note"] } } }
        }
      ]
    }
  }
}

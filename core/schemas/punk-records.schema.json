{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ckomiya/vegapunk-agents/blob/main/core/schemas/punk-records.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 | Copyright 2026 Christian Gonzales Komiya",
  "title": "Punk Records",
  "description": "Shared, append-only memory of one vegapunk-agents mission.",
  "type": "object",
  "required": ["schema_version", "mission", "state", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "mission": {
      "type": "object",
      "required": ["id", "goal", "mode", "roster", "constraints", "max_iterations", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "goal": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["light", "standard", "full"] },
        "roster": {
          "type": "array",
          "items": { "$ref": "#/$defs/satelliteId" },
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "punk-01-shaka" }
        },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "max_iterations": { "type": "integer", "minimum": 0, "default": 2 },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "state": {
      "type": "object",
      "required": ["phase", "iteration", "status", "updated_at"],
      "additionalProperties": false,
      "properties": {
        "phase": { "$ref": "#/$defs/phase" },
        "iteration": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["active", "completed", "failed", "aborted"] },
        "updated_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "satelliteId": {
      "enum": [
        "punk-01-shaka",
        "punk-02-lilith",
        "punk-03-edison",
        "punk-04-pythagoras",
        "punk-05-atlas",
        "punk-06-york"
      ]
    },
    "authorId": {
      "enum": [
        "stella",
        "punk-01-shaka",
        "punk-02-lilith",
        "punk-03-edison",
        "punk-04-pythagoras",
        "punk-05-atlas",
        "punk-06-york"
      ]
    },
    "phase": {
      "enum": [
        "DEFINED",
        "RESEARCH",
        "IDEATION",
        "CRITIQUE",
        "REVISION",
        "VERDICT",
        "HITL_APPROVAL",
        "EXECUTION",
        "OPERATIONS",
        "COMPLETED",
        "FAILED",
        "ABORTED"
      ]
    },
    "recordType": {
      "enum": [
        "goal",
        "finding",
        "proposal",
        "critique",
        "revision",
        "verdict",
        "approval",
        "artifact",
        "ops_log",
        "note"
      ]
    },
    "verdictValue": {
      "enum": ["APPROVED", "NEEDS_REVISION", "REJECTED"]
    },
    "record": {
      "type": "object",
      "required": ["id", "author", "type", "phase", "iteration", "content", "refs", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "author": { "$ref": "#/$defs/authorId" },
        "type": { "$ref": "#/$defs/recordType" },
        "phase": { "$ref": "#/$defs/phase" },
        "iteration": { "type": "integer", "minimum": 0 },
        "content": { "type": "string", "description": "Markdown allowed." },
        "refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "description": "Ids of earlier records this record builds on or corrects."
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "verdict": { "$ref": "#/$defs/verdictValue" },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "verdict" } }, "required": ["type"] },
          "then": { "required": ["verdict"] },
          "else": { "not": { "required": ["verdict"] } }
        },
        {
          "if": { "properties": { "author": { "const": "stella" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["goal", "approval", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-01-shaka" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["verdict", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-02-lilith" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["critique", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-03-edison" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["proposal", "revision", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-04-pythagoras" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["finding", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-05-atlas" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["artifact", "note"] } } }
        },
        {
          "if": { "properties": { "author": { "const": "punk-06-york" } }, "required": ["author"] },
          "then": { "properties": { "type": { "enum": ["ops_log", "note"] } } }
        }
      ]
    }
  }
}
